# Supabase project URL and publishable (anon) key. The key is only used on the server.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
# Public base URL used for canonical links, sitemap and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: MapLibre style URL for maps (defaults to OpenFreeMap Positron).
# NEXT_PUBLIC_MAP_STYLE_URL=
